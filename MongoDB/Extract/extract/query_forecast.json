{
  "connection": "mongodb://fews_admin:{password}@knxpwmongodb1.main.tva.gov:27017/?tls=true&authSource=admin",
  "database": "FEWS_ARCHIVE",
  "queries": [
    {
      "resume": true,
      "max_age_hours": 720,
      "collection": "ExternalForecastingScalarTimeSeries",
      "forecast_time_key": "forecastTime",
      "event_time_key": "t",
      "event_value_key": "v",
      "lead_time_days": 14,
      "forecast_time_chunk_size": 1000,
      "file_format": "nc",
      "batch_size": 100,
      "threads": 16,
      "filter": {
        "moduleInstanceId": [
          "^ImportBrookfieldForecast$",
          "^ImportCumberlandFlowsheet$",
          "^ImportDukeForecast$",
          "^ImportLMRFCForecast$",
          "^ImportRaccoonMountainForecast$",
          "^QPF_to_MAP$",
          "^RW_6Hour_To_FEWS$",
          "^RW_Hourly_To_FEWS$",
          "^RW_LT_To_FEWS$",
          "^RW_NonPower_To_FEWS$",
          "^RW_Ocoee_To_FEWS$",
          "^RW_SelectMaxMinEnergy$",
          "^Send_Final_Flowsheet$",
          "^Send_Final_Preschedule$"],
        "parameterId": [],
        "qualifierId": [],
        "ensembleId": [],
        "locationId" : [],
        "encodedTimeStepId": ["^(?!(?:DOY_)).*$"]
      }
    },
    {
      "resume": true,
      "max_age_hours": 720,
      "collection": "SimulatedForecastingScalarTimeSeries",
      "forecast_time_key": "forecastTime",
      "event_time_key": "t",
      "event_value_key": "v",
      "lead_time_days": 14,
      "forecast_time_chunk_size": 1000,
      "file_format": "nc",
      "batch_size": 100,
      "threads": 16,
      "filter": {
        "moduleInstanceId": [
          "^ADJUSTQ_.+_Forecast$",
          "^MergeMAP_.+_Forecast$",
          "^Preprocess_QR_Kingston$",
          "^RAS_.+_Forecast$",
          "^SUM_LAGK_.+_Forecast$",
          "^TOTAL_.+_Forecast$",
          "^UNITHG_.+_Forecast$"],
        "parameterId": [],
        "qualifierId": [],
        "ensembleId": [],
        "locationId" : [],
        "encodedTimeStepId": ["^(?!(?:DOY_)).*$"]
      }
    }
  ]
}