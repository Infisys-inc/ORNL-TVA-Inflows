{
  "connection": "mongodb://fews_admin:{password}@knxpwmongodb1.main.tva.gov:27017/?tls=true&authSource=admin",
  "database": "FEWS_ARCHIVE",
  "queries": [
    {
      "resume": true,
      "max_age_hours": 720,
      "collection": "ExternalHistoricalScalarTimeSeries",
      "event_start_time_key": "startTime",
      "event_end_time_key": "endTime",
      "event_time_key": "t",
      "event_value_key": "v",
      "observed_time_chunk_size": 1000,
      "file_format": "nc",
      "threads": 16,
      "filter": {
        "moduleInstanceId" : [
          "^LOCAL_.+_Observed$",
          "^Preprocess_HG_to_QR$",
          "^Preprocess_HP_to_LS$",
          "^Preprocess_HP$",
          "^Preprocess_HT$",
          "^Preprocess_QI$",
          "^Preprocess_QT$",
          "^QPE_to_MAP$"],
        "parameterId" : [],
        "qualifierId" : [],
        "locationId" : [],
        "encodedTimeStepId": ["^(?!(?:DOY_)).*$"]
      }
    }
  ]
}